# PostgreSQL connection used by Prisma and the application.
DATABASE_URL="postgresql://mathforces:mathforces@localhost:5432/mathforces?schema=public"
DATABASE_POOL_SIZE=15
# Оставьте пустым для автоматического выбора: false на localhost/LAN HTTP,
# true на публичном production-хосте. За HTTPS reverse proxy используется
# X-Forwarded-Proto. Явно задавайте только при нестандартной инфраструктуре.
SESSION_COOKIE_SECURE=
HEALTH_MAX_QUEUE_AGE_SECONDS=120
SUBMISSION_STORAGE_DIR="./storage/submissions"

# Local OCR. The worker tries languages in order and records failures in the
# evaluation audit. Install the selected Tesseract language packs on the host.
TESSERACT_BINARY="tesseract"
TESSERACT_LANGUAGES="rus+eng,eng"

# Optional OpenAI-compatible multimodal endpoint for strong archive judging
# and the monthly archive difficulty adviser. Without it both workflows use
# their safe local fallback and uncertain solution scores require admin review.
# Without all three values, attempts use local OCR/heuristics and are sent to
# an administrator for confirmation.
MATHFORCES_LLM_ENDPOINT=""
MATHFORCES_LLM_API_KEY=""
MATHFORCES_LLM_MODEL=""

# Public contact shown at the bottom of FAQ (for example a Telegram URL).
NEXT_PUBLIC_SUPPORT_URL=""

# Backup script destination and local retention. Production backups must also
# be copied off-host and periodically restored in a separate environment.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=14
